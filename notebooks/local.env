# Used explicitly with: uv --directory notebooks run --env-file local.env ...
# All paths are relative to notebooks/, the working directory of those commands.
HF_HOME=.artifacts/huggingface
TORCH_HOME=.artifacts/torch
MPLCONFIGDIR=.artifacts/matplotlib
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_OFFLINE=1
