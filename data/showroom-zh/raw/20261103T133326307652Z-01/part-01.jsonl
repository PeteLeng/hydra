{"record_id":"20261103T133326307652Z-01-000044","text":"现在可以恢复演示了","intent":"request_resume","slots":[]}
{"record_id":"20261103T133326307652Z-01-000045","text":"我想退出整个展厅体验","intent":"request_quit","slots":[]}
