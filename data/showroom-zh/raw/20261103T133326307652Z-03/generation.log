",\n    \"[[choice:第9个]]\",\n    \"[[choice:第10个]]吧\",\n    \"我选[[choice:选项一]]\",\n    \"选[[choice:选项二]]吧\",\n    \"给我[[choice:选项三]]\",\n    \"就[[choice:选项四]]吧\",\n    \"我要[[choice:选项五]]\",\n    \"就[[choice:选项六]]\",\n    \"那就[[choice:选项七]]\",\n    \"我看[[choice:选项八]]吧\",\n    \"选[[choice:选项九]]\",\n    \"我选[[choice:选项十]]\",\n    \"就[[choice:1号]]\",\n    \"[[choice:2号]]吧\",\n    \"选[[choice:8号]]\",\n    \"我要[[choice:9号]]\",\n    \"给我[[choice:10号]]\",\n    # flow_ref only 20\n    \"[[flow_ref:座舱影院]]\",\n    \"[[flow_ref:车载影院]]吧\",\n    \"我更喜欢[[flow_ref:移动影院]]\",\n    \"[[flow_ref:车里的电影院|cabin_cinema]]\",\n    \"那就[[flow_ref:车载影院]]\",\n    \"[[flow_ref:DLP大灯]]\",\n    \"我喜欢[[flow_ref:大灯]]\",\n    \"[[flow_ref:DLP车灯]]吧\",\n    \"我选[[flow_ref:大灯]]\",\n    \"[[flow_ref:大灯]]\",\n    \"[[flow_ref:按摩座椅]]\",\n    \"我更喜欢[[flow_ref:座椅按摩]]\",\n    \"[[flow_ref:座椅按摩]]吧\",\n    \"就[[flow_ref:按摩椅|massage_seats]]\",\n    \"[[flow_ref:按摩座椅]]比较好\",\n    \"[[flow_ref:隐私玻璃]]\",\n    \"我喜欢[[flow_ref:隐私车窗]]\",\n    \"[[flow_ref:隐私车窗]]吧\",\n    \"就[[flow_ref:隐私窗|privacy_window]]\",\n    \"我选[[flow_ref:隐私玻璃]]\",\n    # part only 15\n    \"[[part:车内]]的吧\",\n    \"我更喜欢[[part:车内]]\",\n    \"[[part:内饰]]\",\n    \"[[part:座舱里]]的\",\n    \"就[[part:车内]]\",\n    \"我选[[part:内饰]]\",\n    \"[[part:车里|inside]]吧\",\n    \"[[part:车外]]的吧\",\n    \"我更喜欢[[part:车外]]\",\n    \"[[part:外饰]]\",\n    \"就[[part:车外]]\",\n    \"[[part:车外面|outside]]的\",\n    \"我选[[part:外饰]]\",\n    \"[[part:座舱内|inside]]吧\",\n    \"[[part:外饰]]方面的\",\n    # theme only 15\n    \"[[theme:家庭]]的吧\",\n    \"我更喜欢[[theme:家庭]]\",\n    \"[[theme:娱乐]]\",\n    \"就[[theme:娱乐]]\",\n    \"[[theme:隐私]]的\",\n    \"我喜欢[[theme:私密]]的\",\n    \"[[theme:全家]]向的吧\",\n    \"[[theme:家用]]\",\n    \"就[[theme:家庭]]\",\n    \"[[theme:娱乐]]方面的\",\n    \"我更喜欢[[theme:隐私]]\",\n    \"[[theme:私密]]吧\",\n    \"适合[[theme:家庭]]的\",\n    \"[[theme:娱乐]]的吧\",\n    \"就[[theme:私密]]\",\n    # part + theme 18\n    \"我更喜欢[[part:车内]]适合[[theme:家庭]]的功能\",\n    \"[[part:车内]]的[[theme:娱乐]]吧\",\n    \"我喜欢[[part:座舱里]]的[[theme:隐私]]功能\",\n    \"[[part:外饰]]的[[theme:家庭]]方面\",\n    \"[[part:车外]]适合[[theme:娱乐]]的\",\n    \"我更喜欢[[part:车外]]的[[theme:隐私]]\",\n    \"[[part:内饰]]方面[[theme:家用]]的吧\",\n    \"[[part:座舱里]]的[[theme:娱乐]]方面\",\n    \"我喜欢[[part:车内]]偏[[theme:私密]]的\",\n    \"[[part:车外]]适合[[theme:全家]]的吧\",\n    \"[[part:外饰]]方面[[theme:娱乐]]的\",\n    \"我更喜欢[[part:内饰]]的[[theme:娱乐]]功能\",\n    \"[[part:车内]]的[[theme:家庭]]\",\n    \"[[part:车外]]的[[theme:私密]]功能吧\",\n    \"我喜欢[[part:外饰]]适合[[theme:家庭]]的\",\n    \"[[part:座舱内|inside]]的[[theme:娱乐]]吧\",\n    \"[[part:车外面|outside]]偏[[theme:隐私]]的\",\n    \"我更喜欢[[part:车里|inside]]适合[[theme:全家]]的\",\n    # flow_ref + part 4\n    \"我喜欢[[part:车外]]的[[flow_ref:DLP大灯]]\",\n    \"[[part:车内]]的[[flow_ref:按摩座椅]]吧\",\n    \"我更喜欢[[part:座舱里]]的[[flow_ref:车载影院]]\",\n    \"[[part:外饰]]的[[flow_ref:隐私玻璃]]\",\n    # flow_ref + theme 4\n    \"我喜欢适合[[theme:家庭]]的[[flow_ref:座舱影院]]\",\n    \"[[theme:娱乐]]的[[flow_ref:按摩座椅]]吧\",\n    \"我更喜欢[[theme:私密]]的[[flow_ref:隐私车窗]]\",\n    \"[[theme:全家]]向的[[flow_ref:DLP大灯]]\",\n    # flow_ref + part + theme 4\n    \"我更喜欢[[part:车内]]适合[[theme:家庭]]的[[flow_ref:座舱影院]]\",\n    \"[[part:车外]]适合[[theme:娱乐]]的[[flow_ref:DLP大灯]]吧\",\n    \"我喜欢[[part:座舱里]]适合[[theme:娱乐]]的[[flow_ref:按摩座椅]]\",\n    \"[[part:外饰]]偏[[theme:私密]]的[[flow_ref:隐私玻璃]]\",\n])\n\n\ndef parse(marked):\n    slots = []\n    hints = []\n    text_parts = []\n    pos = 0\n    cursor = 0\n    for m in MARKER.finditer(marked):\n        text_parts.append(marked[cursor:m.start()])\n        surface = m.group(2)\n        typ = m.group(1)\n        hint = m.group(3)\n        start = pos + (m.start() - cursor)\n        # pos tracks cleaned length; characters before this match in the gap\n        # recompute start from assembled prefix\n        text_parts.append(surface)\n        cursor = m.end()\n        slots.append((typ, surface, hint))\n    text_parts.append(marked[cursor:])\n    text = \"\".join(text_parts)\n    # rebuild spans against text\n    rebuilt = []\n    search_from = 0\n    for typ, surface, hint in slots:\n        start = text.find(surface, search_from)\n        if start < 0:\n            raise SystemExit(f\"surface not found: {surface!r} in {text!r}\")\n        end = start + len(surface)\n        if text[start:end] != surface:\n            raise SystemExit(\"span mismatch\")\n        rebuilt.append({\"type\": typ, \"start\": start, \"end\": end, \"_hint\": hint, \"_surface\": surface})\n        search_from = end\n    return text, rebuilt\n\n\ndef main():\n    if len(ROWS) != 500:\n        raise SystemExit(f\"row count {len(ROWS)} != 500\")\n    records = []\n    errors = []\n    for i, (intent, marked) in enumerate(ROWS, 1):\n        text, slots = parse(marked)\n        bad = [ch for ch in text if ch in TRAD]\n        if bad:\n            errors.append(f\"trad {text!r} {bad}\")\n        if \"[[\" in text or \"]]\" in text:\n            errors.append(f\"marker leak {text!r}\")\n        types = [s[\"type\"] for s in slots]\n        if len(types) != len(set(types)):\n            errors.append(f\"dup slot type {text!r} {types}\")\n        for s in slots:\n            if s[\"type\"] not in ALLOWED[intent]:\n                errors.append(f\"slot not allowed {intent} {s['type']} {text!r}\")\n            if text[s[\"start\"]:s[\"end\"]] != s[\"_surface\"]:\n                errors.append(f\"offset {text!r}\")\n            if s[\"type\"] == \"flow_ref\":\n                known = FLOW.get(s[\"_surface\"])\n                if known and s[\"_hint\"] and s[\"_hint\"] != known:\n                    errors.append(f\"bad flow hint {text!r}\")\n                if not known and not s[\"_hint\"]:\n                    errors.append(f\"flow needs hint {s['_surface']!r} {text!r}\")\n                if s[\"_hint\"] and s[\"_hint\"] not in FLOW.values():\n                    errors.append(f\"unknown flow hint {s['_hint']}\")\n            if s[\"type\"] == \"part\":\n                known = PART.get(s[\"_surface\"])\n                if known and s[\"_hint\"] and s[\"_hint\"] != known:\n                    errors.append(f\"bad part hint {text!r}\")\n                if not known and not s[\"_hint\"]:\n                    errors.append(f\"part needs hint {s['_surface']!r} {text!r}\")\n                if s[\"_hint\"] and s[\"_hint\"] not in (\"inside\", \"outside\"):\n                    errors.append(f\"unknown part hint {s['_hint']}\")\n            if s[\"type\"] == \"theme\":\n                known = THEME.get(s[\"_surface\"])\n                if known and s[\"_hint\"] and s[\"_hint\"] != known:\n                    errors.append(f\"bad theme hint {text!r}\")\n                if not known and not s[\"_hint\"]:\n                    errors.append(f\"theme needs hint {s['_surface']!r}\")\n                if s[\"_hint\"] and s[\"_hint\"] not in THEME.values():\n                    errors.append(f\"unknown theme hint {s['_hint']}\")\n        if intent == \"greet\" and slots and slots[0][\"start\"] == 0:\n            errors.append(f\"name-first greet {text!r}\")\n        clean_slots = [{\"type\": s[\"type\"], \"start\": s[\"start\"], \"end\": s[\"end\"]} for s in slots]\n        hint_objs = []\n        for idx, s in enumerate(slots):\n            if s[\"_hint\"]:\n                hint_objs.append({\"slot\": idx, \"value\": s[\"_hint\"]})\n        rec = {\n            \"record_id\": f\"{PREFIX}-{i:06d}\",\n            \"text\": text,\n            \"intent\": intent,\n            \"slots\": clean_slots,\n        }\n        if hint_objs:\n            rec[\"slot_hints\"] = hint_objs\n        records.append(rec)\n\n    texts = [r[\"text\"] for r in records]\n    dup = [t for t, c in Counter(texts).items() if c > 1]\n    if dup:\n        errors.append(f\"dup texts: {dup}\")\n    ids = [r[\"record_id\"] for r in records]\n    if len(set(ids)) != 500:\n        errors.append(\"dup ids\")\n    if ids[0] != f\"{PREFIX}-000001\" or ids[-1] != f\"{PREFIX}-000500\":\n        errors.append(\"id range\")\n\n    ic = Counter(r[\"intent\"] for r in records)\n    expect = {\n        \"request_flow\": 140,\n        \"inform\": 140,\n        \"greet\": 40,\n        \"affirm\": 30,\n        \"deny\": 30,\n        \"request_stop\": 30,\n        \"request_resume\": 30,\n        \"request_quit\": 30,\n        \"UNK\": 30,\n    }\n    if dict(ic) != expect:\n        errors.append(f\"intent counts {dict(ic)}\")\n\n    greets = [r for r in records if r[\"intent\"] == \"greet\"]\n    g_name = sum(1 for r in greets if r[\"slots\"])\n    if g_name != 20:\n        errors.append(f\"greet name {g_name}\")\n\n    rf = [r for r in records if r[\"intent\"] == \"request_flow\"]\n    def kinds(r):\n        ts = {s[\"type\"] for s in r[\"slots\"]}\n        return ts\n    rf_none = sum(1 for r in rf if not r[\"slots\"])\n    rf_flow = sum(1 for r in rf if \"flow_ref\" in kinds(r))\n    rf_part = sum(1 for r in rf if kinds(r) == {\"part\"})\n    rf_theme = sum(1 for r in rf if kinds(r) == {\"theme\"})\n    rf_pt = sum(1 for r in rf if kinds(r) == {\"part\", \"theme\"})\n    rf_extra = sum(1 for r in rf if \"flow_ref\" in kinds(r) and kinds(r) - {\"flow_ref\"})\n    if (rf_none, rf_flow, rf_part, rf_theme, rf_pt) != (20, 40, 25, 25, 30):\n        errors.append(f\"rf split {(rf_none, rf_flow, rf_part, rf_theme, rf_pt)}\")\n    if rf_extra != 10:\n        errors.append(f\"rf extra {rf_extra}\")\n    if rf_none + rf_flow + rf_part + rf_theme + rf_pt != 140:\n        errors.append(\"rf partition\")\n\n    inf = [r for r in records if r[\"intent\"] == \"inform\"]\n    inf_types = set()\n    for r in inf:\n        inf_types |= {s[\"type\"] for s in r[\"slots\"]}\n    if inf_types != {\"name\", \"flow_ref\", \"part\", \"theme\", \"choice\"}:\n        errors.append(f\"inform types {inf_types}\")\n    multi = sum(1 for r in inf if len(r[\"slots\"]) >= 2)\n    if multi < 20:\n        errors.append(f\"inform multi {multi}\")\n\n    # choice coverage\n    choices = []\n    for r in records:\n        for s in r[\"slots\"]:\n            if s[\"type\"] == \"choice\":\n                choices.append(r[\"text\"][s[\"start\"]:s[\"end\"]])\n    joined = \" \".join(choices)\n    han = [\"一\", \"二\", \"三\", \"四\", \"五\", \"六\", \"七\", \"八\", \"九\", \"十\"]\n    for h in han:\n        if h not in joined:\n            errors.append(f\"choice missing han {h}\")\n    for n in range(1, 11):\n        if str(n) not in joined:\n            errors.append(f\"choice missing digit {n}\")\n\n    # function / part / theme coverage in inform and request_flow\n    def canon_flow(r, s):\n        surface = r[\"text\"][s[\"start\"]:s[\"end\"]]\n        if surface in FLOW:\n            return FLOW[surface]\n        hints = {h[\"slot\"]: h[\"value\"] for h in r.get(\"slot_hints\", [])}\n        return hints.get(r[\"slots\"].index(s))\n\n    def canon_part(r, s):\n        surface = r[\"text\"][s[\"start\"]:s[\"end\"]]\n        if surface in PART:\n            return PART[surface]\n        hints = {h[\"slot\"]: h[\"value\"] for h in r.get(\"slot_hints\", [])}\n        return hints.get(r[\"slots\"].index(s))\n\n    def canon_theme(r, s):\n        surface = r[\"text\"][s[\"start\"]:s[\"end\"]]\n        if surface in THEME:\n            return THEME[surface]\n        hints = {h[\"slot\"]: h[\"value\"] for h in r.get(\"slot_hints\", [])}\n        return hints.get(r[\"slots\"].index(s))\n\n    for label, subset in (\"inform\", inf), (\"request_flow\", rf):\n        flows, parts, themes = set(), set(), set()\n        for r in subset:\n            for s in r[\"slots\"]:\n                if s[\"type\"] == \"flow_ref\":\n                    flows.add(canon_flow(r, s))\n                elif s[\"type\"] == \"part\":\n                    parts.add(canon_part(r, s))\n                elif s[\"type\"] == \"theme\":\n                    themes.add(canon_theme(r, s))\n        if label == \"inform\" or label == \"request_flow\":\n            if flows and flows != set(FLOW.values()) and label == \"request_flow\":\n                # request_flow with names should cover 4; part/theme-only won't add flows\n                pass\n        if label == \"inform\":\n            if flows != set(FLOW.values()):\n                errors.append(f\"inform flows {flows}\")\n            if parts != {\"inside\", \"outside\"}:\n                errors.append(f\"inform parts {parts}\")\n            if themes != {\"family\", \"entertainment\", \"privacy\"}:\n                errors.append(f\"inform themes {themes}\")\n        if label == \"request_flow\":\n            if parts != {\"inside\", \"outside\"}:\n                errors.append(f\"rf parts {parts}\")\n            if themes != {\"family\", \"entertainment\", \"privacy\"}:\n                errors.append(f\"rf themes {themes}\")\n            if flows != set(FLOW.values()):\n                errors.append(f\"rf flows {flows}\")\n\n    # ambiguous control phrases\n    banned = [\"不用了\", \"算了\", \"结束吧\"]\n    for r in records:\n        for b in banned:\n            if b in r[\"text\"]:\n                errors.append(f\"banned phrase {b} in {r['text']!r}\")\n\n    # compound-ish greet+request\n    for r in records:\n        if r[\"intent\"] != \"greet\" and r[\"text\"].startswith(\"你好\") and \"我叫\" not in r[\"text\"] and \"我是\" not in r[\"text\"]:\n            if any(k in r[\"text\"] for k in (\"体验\", \"演示\", \"看看\")):\n                errors.append(f\"compound {r['text']!r}\")\n\n    if errors:\n        print(\"ERRORS\", len(errors))\n        for e in errors:\n            print(e)\n        raise SystemExit(1)\n\n    # write files\n    for pi in range(10):\n        chunk = records[pi * 50:(pi + 1) * 50]\n        path = OUT / f\"part-{pi + 1:02d}.jsonl\"\n        with path.open(\"w\", encoding=\"utf-8\", newline=\"\\n\") as f:\n            for rec in chunk:\n                f.write(json.dumps(rec, ensure_ascii=False, separators=(\",\", \":\")) + \"\\n\")\n        if sum(1 for _ in path.open(encoding=\"utf-8\")) != 50:\n            raise SystemExit(f\"bad line count {path}\")\n\n    print(\"wrote\", len(records))\n    print(\"intents\", dict(ic))\n    print(\"rf\", rf_none, rf_flow, rf_part, rf_theme, rf_pt, \"extra\", rf_extra)\n    print(\"inform multi\", multi)\n    print(\"choices\", len(choices))\n    # highlight sample\n    review = OUT.parent.parent.parent / \"..\" \n    rev_path = Path(r\"C:/Users/ghost/AppData/Local/Temp/opencode/showroom_review.txt\")\n    with rev_path.open(\"w\", encoding=\"utf-8\", newline=\"\\n\") as f:\n        for r in records:\n            t = r[\"text\"]\n            bits = []\n            last = 0\n            for s in r[\"slots\"]:\n                bits.append(t[last:s[\"start\"]])\n                bits.append(\"[\" + s[\"type\"] + \":\" + t[s[\"start\"]:s[\"end\"]] + \"]\")\n                last = s[\"end\"]\n            bits.append(t[last:])\n            f.write(f\"{r['record_id']}\\t{r['intent']}\\t{''.join(bits)}\\n\")\n    print(\"review\", rev_path)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"C:\\Users\\ghost\\AppData\\Local\\Temp\\opencode\\gen_showroom_zh.py","exists":false,"truncated":false},"title":"..\\..\\..\\Users\\ghost\\AppData\\Local\\Temp\\opencode\\gen_showroom_zh.py","time":{"start":1793713371784,"end":1793713371797}},"metadata":{"openai":{"itemId":"fc_67e59a05-1148-9fd5-b714-4fab1f1d4f8c_0"}},"id":"prt_1a1a5f5d8001GpDFVFhKwkNA7g","sessionID":"ses_e5e629ec9ffeywHqTHzMr6o1wp","messageID":"msg_1a19e39e0001Nua1B7aCmks6E1"}}
