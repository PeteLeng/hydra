{"type":"tool_use","timestamp":1793713481424,"sessionID":"ses_e5e629f95ffebBd7N9Oy0Wkexs","part":{"type":"tool","tool":"write","callID":"call-014f6c34-1c2e-4472-8fb1-c997a512d2ae-3","state":{"status":"completed","input":{"filePath":"C:\\Users\\ghost\\AppData\\Local\\Temp\\opencode\\gen_showroom.py","content":"# -*- coding: utf-8 -*-\nimport json\nimport re\nfrom collections import Counter\nfrom pathlib import Path\n\nOUT = Path(r\"C:\\home\\proj\\nlu\\data\\showroom-zh\\raw\\20261103T133326307652Z-02\")\nPREFIX = \"20261103T133326307652Z-02\"\n\nSLOT_RE = re.compile(\n    r\"\\[(name|flow_ref|part|theme|choice):([^|\\]]+)(?:\\|([a-z_]+))?\\]\"\n)\n\nKNOWN_FLOW = {\n    \"DLP大灯\": \"dlp_headlights\",\n    \"DLP车灯\": \"dlp_headlights\",\n    \"大灯\": \"dlp_headlights\",\n    \"座舱影院\": \"cabin_cinema\",\n    \"车载影院\": \"cabin_cinema\",\n    \"移动影院\": \"cabin_cinema\",\n    \"按摩座椅\": \"massage_seats\",\n    \"座椅按摩\": \"massage_seats\",\n    \"隐私车窗\": \"privacy_window\",\n    \"隐私玻璃\": \"privacy_window\",\n}\nKNOWN_PART = {\n    \"车内\": \"inside\",\n    \"内饰\": \"inside\",\n    \"座舱里\": \"inside\",\n    \"车外\": \"outside\",\n    \"外饰\": \"outside\",\n}\nKNOWN_THEME = {\n    \"家庭\": \"family\",\n    \"全家\": \"family\",\n    \"家用\": \"family\",\n    \"娱乐\": \"entertainment\",\n    \"隐私\": \"privacy\",\n    \"私密\": \"privacy\",\n}\nHINT_OK = {\n    \"dlp_headlights\",\n    \"cabin_cinema\",\n    \"massage_seats\",\n    \"privacy_window\",\n    \"inside\",\n    \"outside\",\n    \"family\",\n    \"entertainment\",\n    \"privacy\",\n}\nCN_NUM = set(\"一二三四五六七八九十\")\nARB_NUM = set(\"0123456789\")\n\n\ndef parse(markup):\n    slots = []\n    hints = []\n    parts = []\n    pos = 0\n    out = 0\n    for m in SLOT_RE.finditer(markup):\n        parts.append(markup[pos:m.start()])\n        out += m.start() - pos\n        surface = m.group(2)\n        typ = m.group(1)\n        hint = m.group(3)\n        start = out\n        end = out + len(surface)\n        idx = len(slots)\n        slots.append({\"type\": typ, \"start\": start, \"end\": end, \"_surface\": surface})\n        if hint:\n            hints.append({\"slot\": idx, \"value\": hint})\n        parts.append(surface)\n        out = end\n        pos = m.end()\n    parts.append(markup[pos:])\n    text = \"\".join(parts)\n    return text, slots, hints\n\n\ndef build(sections):\n    records = []\n    errors = []\n    n = 0\n    for name, intent, items in sections:\n        if len(items) != {\n            \"greet_plain\": 20,\n            \"greet_name\": 20,\n            \"affirm\": 30,\n            \"deny\": 30,\n            \"stop\": 30,\n            \"resume\": 30,\n            \"quit\": 30,\n            \"unk\": 30,\n            \"rf_none\": 20,\n            \"rf_flow\": 30,\n            \"rf_flow_extra\": 10,\n            \"rf_part\": 25,\n            \"rf_theme\": 25,\n            \"rf_part_theme\": 30,\n            \"inf_name\": 20,\n            \"inf_flow\": 25,\n            \"inf_part\": 15,\n            \"inf_theme\": 15,\n            \"inf_choice\": 25,\n            \"inf_part_theme\": 15,\n            \"inf_flow_part\": 5,\n            \"inf_flow_theme\": 5,\n            \"inf_name_other\": 5,\n            \"inf_triple\": 3,\n            \"inf_choice_other\": 4,\n            \"inf_name_pt\": 3,\n        }[name]:\n            errors.append(f\"section {name} count {len(items)}\")\n        for markup in items:\n            n += 1\n            text, slots, hints = parse(markup)\n            if \"[\" in text or \"]\" in text:\n                errors.append(f\"{n} unparsed markup: {markup}\")\n            for s in slots:\n                got = text[s[\"start\"]:s[\"end\"]]\n                if got != s[\"_surface\"]:\n                    errors.append(f\"{n} span {got!r} != {s['_surface']!r} in {text!r}\")\n            types = [s[\"type\"] for s in slots]\n            if len(types) != len(set(types)):\n                errors.append(f\"{n} duplicate slot type {text}\")\n            starts = [s[\"start\"] for s in slots]\n            if starts != sorted(starts):\n                errors.append(f\"{n} slots out of order {text}\")\n            for i in range(len(slots) - 1):\n                if slots[i][\"end\"] > slots[i + 1][\"start\"]:\n                    errors.append(f\"{n} overlap {text}\")\n            rec = {\n                \"record_id\": f\"{PREFIX}-{n:06d}\",\n                \"text\": text,\n                \"intent\": intent,\n                \"slots\": [{\"type\": s[\"type\"], \"start\": s[\"start\"], \"end\": s[\"end\"]} for s in slots],\n            }\n            if hints:\n                rec[\"slot_hints\"] = hints\n            rec[\"_section\"] = name\n            rec[\"_raw_slots\"] = slots\n            records.append(rec)\n    return records, errors\n\n\ngreet_plain = [\n    \"你好\",\n    \"您好\",\n    \"嗨\",\n    \"早上好\",\n    \"下午好\",\n    \"晚上好\",\n    \"你好啊\",\n    \"早\",\n    \"嘿\",\n    \"大家好\",\n    \"哈喽\",\n    \"中午好\",\n    \"嗨你好\",\n    \"您好呀\",\n    \"早上好啊\",\n    \"小周你好\",\n    \"你好呀\",\n    \"嗨呀\",\n    \"你好，我来了\",\n    \"您好，请问有人吗\",\n]\ngreet_name = [\n    \"嗨，我叫[name:小周]\",\n    \"你好，我叫[name:陈静]\",\n    \"您好我是[name:张伟]\",\n    \"早上好，我叫[name:王芳]\",\n    \"你好啊，我是[name:赵磊]\",\n    \"您好，我叫[name:欧阳晨]\",\n    \"嗨我是[name:小李]\",\n    \"大家好，我叫[name:周婷]\",\n    \"你好我是[name:林晓燕]\",\n    \"嗨，我叫[name:Alex]\",\n    \"早上好我姓[name:陈]\",\n    \"您好呀，我叫[name:吴佳]\",\n    \"哈喽，我是[name:郑凯]\",\n    \"你好啊我叫[name:黄丽]\",\n    \"嗨你好，我叫[name:Emma]\",\n    \"你好，我是[name:马超]\",\n    \"您好我叫[name:何静]\",\n    \"早上好，我叫[name:Tom]\",\n    \"嗨，我是[name:孙浩]\",\n    \"你好呀，我叫[name:陈晓]\",\n]\naffirm = [\n    \"对的\",\n    \"可以啊\",\n    \"好的\",\n    \"是的\",\n    \"没错\",\n    \"行\",\n    \"可以\",\n    \"对\",\n    \"嗯对\",\n    \"好\",\n    \"没问题\",\n    \"同意\",\n    \"是啊\",\n    \"就这么定\",\n    \"没意见\",\n    \"嗯\",\n    \"正确\",\n    \"中\",\n    \"是\",\n    \"成\",\n    \"我同意\",\n    \"是这样\",\n    \"没问题的\",\n    \"赞同\",\n    \"好嘞\",\n    \"嗯，可以\",\n    \"完全同意\",\n    \"