    \"[flow_ref:DLP车灯]\",\n    \"就[flow_ref:移动影院]\",\n    \"[flow_ref:座椅按摩]比较好\",\n    \"[flow_ref:隐私车窗]吧\",\n    \"[flow_ref:大灯]比较合适\",\n    \"[flow_ref:座舱影院]就行\",\n    \"[flow_ref:车载电影院|cabin_cinema]\",\n    \"[flow_ref:按摩椅|massage_seats]\",\n    \"[flow_ref:DLP灯|dlp_headlights]吧\",\n    \"[flow_ref:隐私窗|privacy_window]\",\n    \"[flow_ref:移动电影院|cabin_cinema]比较有意思\",\n]\ninf_part = [\n    \"[part:车内]吧\",\n    \"我更喜欢[part:车内]\",\n    \"[part:外饰]\",\n    \"[part:座舱里]\",\n    \"[part:车外]的\",\n    \"[part:内饰]吧\",\n    \"我偏向[part:车外]\",\n    \"[part:座舱内|inside]\",\n    \"就[part:外饰]\",\n    \"[part:车内]\",\n    \"我偏好[part:内饰]\",\n    \"[part:车外]吧\",\n    \"[part:外饰]比较好\",\n    \"就[part:车内]\",\n    \"[part:车厢里|inside]\",\n]\ninf_theme = [\n    \"[theme:家庭]的\",\n    \"我喜欢[theme:娱乐]\",\n    \"[theme:隐私]吧\",\n    \"[theme:家用]的\",\n    \"[theme:私密]\",\n    \"就[theme:娱乐]\",\n    \"[theme:全家]的吧\",\n    \"我偏好[theme:隐私]\",\n    \"[theme:娱乐]比较好\",\n    \"[theme:私密]的\",\n    \"[theme:家用]\",\n    \"就[theme:家庭]\",\n    \"[theme:娱乐]\",\n    \"[theme:隐私]比较好\",\n    \"[theme:一家人|family]的\",\n]\ninf_choice = [\n    \"[choice:第一个]\",\n    \"就[choice:第二个]\",\n    \"[choice:第三个]\",\n    \"就[choice:第四个]\",\n    \"[choice:第五个]吧\",\n    \"[choice:第六个]\",\n    \"[choice:第七个]\",\n    \"就[choice:第八个]\",\n    \"[choice:第九个]吧\",\n    \"[choice:第十个]\",\n    \"[choice:第1个]\",\n    \"就[choice:第2个]\",\n    \"[choice:第4个]\",\n    \"选[choice:第6个]\",\n    \"我要[choice:第8个]\",\n    \"[choice:第10个]吧\",\n    \"[choice:选项一]\",\n    \"[choice:选项三]\",\n    \"[choice:选项六]\",\n    \"[choice:1号]\",\n    \"就[choice:2号]\",\n    \"[choice:3号]\",\n    \"就[choice:5号]\",\n    \"[choice:7号]吧\",\n    \"给我看看[choice:第9个]\",\n]\ninf_part_theme = [\n    \"[part:车内]适合[theme:家庭]的我更倾向\",\n    \"[part:车外]的[theme:娱乐]吧\",\n    \"[part:内饰][theme:私密]的比较好\",\n    \"我偏好[part:座舱里]的[theme:家用]功能\",\n    \"[part:外饰][theme:隐私]的\",\n    \"[part:车内][theme:娱乐]就行\",\n    \"[theme:全家]的，[part:车外]那种\",\n    \"我喜欢[part:内饰]的[theme:家庭]功能\",\n    \"[part:座舱里][theme:私密]一点的\",\n    \"[part:车外][theme:家用]的吧\",\n    \"[theme:娱乐]的[part:外饰]比较好\",\n    \"[part:车内]的[theme:隐私]我更喜欢\",\n    \"适合[theme:全家]的[part:内饰]\",\n    \"[part:座舱里]的[theme:娱乐]\",\n    \"[part:外饰]方面[theme:家庭]的\",\n]\ninf_flow_part = [\n    \"[part:车内]的[flow_ref:座舱影院]\",\n    \"我更喜欢[part:车外]的[flow_ref:DLP大灯]\",\n    \"[part:座舱里]的[flow_ref:按摩座椅]吧\",\n    \"[part:外饰]的[flow_ref:隐私玻璃]\",\n    \"就[part:车内]的[flow_ref:移动影院]\",\n]\ninf_flow_theme = [\n    \"[theme:家庭]的[flow_ref:座舱影院]\",\n    \"我喜欢[theme:娱乐]的[flow_ref:按摩座椅]\",\n    \"[theme:私密]的[flow_ref:隐私车窗]吧\",\n    \"[theme:全家]适用的[flow_ref:车载影院]\",\n    \"[theme:娱乐]向的[flow_ref:DLP大灯]\",\n]\ninf_name_other = [\n    \"我叫[name:陈晨]，更喜欢[part:车内]的\",\n    \"我是[name:高远]，想要[theme:娱乐]的\",\n    \"我叫[name:David]，选[flow_ref:座舱影院]\",\n    \"我姓[name:赵]，要[choice:第二个]\",\n    \"我叫[name:许娜]，偏好[theme:隐私]\",\n]\ninf_triple = [\n    \"[part:车内]适合[theme:家庭]的[flow_ref:座舱影院]\",\n    \"[part:外饰][theme:娱乐]的[flow_ref:DLP车灯]吧\",\n    \"我喜欢[part:车外][theme:私密]的[flow_ref:隐私玻璃]\",\n]\ninf_choice_other = [\n    \"[choice:第二个]，[part:车内]的\",\n    \"我选[choice:第3个]，[theme:娱乐]的\",\n    \"[choice:4号]，[flow_ref:隐私玻璃]\",\n    \"就[choice:第一个]，[theme:家庭]的\",\n]\ninf_name_pt = [\n    \"我叫[name:彭飞]，喜欢[part:车内][theme:家庭]的\",\n    \"我是[name:Anna]，要[part:外饰][theme:娱乐]的\",\n    \"我叫[name:韩雪]，偏好[part:座舱里][theme:私密]的\",\n]\n\nsections = [\n    (\"greet_plain\", \"greet\", greet_plain),\n    (\"greet_name\", \"greet\", greet_name),\n    (\"affirm\", \"affirm\", affirm),\n    (\"deny\", \"deny\", deny),\n    (\"stop\", \"request_stop\", stop),\n    (\"resume\", \"request_resume\", resume),\n    (\"quit\", \"request_quit\", quit_),\n    (\"unk\", \"UNK\", unk),\n    (\"rf_none\", \"request_flow\", rf_none),\n    (\"rf_flow\", \"request_flow\", rf_flow),\n    (\"rf_flow_extra\", \"request_flow\", rf_flow_extra),\n    (\"rf_part\", \"request_flow\", rf_part),\n    (\"rf_theme\", \"request_flow\", rf_theme),\n    (\"rf_part_theme\", \"request_flow\", rf_part_theme),\n    (\"inf_name\", \"inform\", inf_name),\n    (\"inf_flow\", \"inform\", inf_flow),\n    (\"inf_part\", \"inform\", inf_part),\n    (\"inf_theme\", \"inform\", inf_theme),\n    (\"inf_choice\", \"inform\", inf_choice),\n    (\"inf_part_theme\", \"inform\", inf_part_theme),\n    (\"inf_flow_part\", \"inform\", inf_flow_part),\n    (\"inf_flow_theme\", \"inform\", inf_flow_theme),\n    (\"inf_name_other\", \"inform\", inf_name_other),\n    (\"inf_triple\", \"inform\", inf_triple),\n    (\"inf_choice_other\", \"inform\", inf_choice_other),\n    (\"inf_name_pt\", \"inform\", inf_name_pt),\n]\n\nrecords, errors = build(sections)\n\n# example texts that must not be copied\nforbidden_exact = {\n    \"你好，我叫小王\",\n    \"我叫李明\",\n    \"第二个吧\",\n    \"就第2个\",\n    \"车内的吧\",\n    \"我更喜欢车内适合家庭的功能\",\n    \"座舱影院\",\n    \"有什么可以体验的\",\n    \"我想体验按摩座椅\",\n    \"给我看看DLP大灯吧\",\n    \"车内的娱乐功能有什么能体验的\",\n    \"先暂停一下\",\n    \"继续刚才的演示\",\n    \"退出这次体验\",\n    \"帮我订个餐厅\",\n    \"我想试试车里的电影院\",\n}\nambiguous = [\"不用了\", \"算了\", \"结束吧\"]\n\ntexts = [r[\"text\"] for r in records]\ndup = [t for t, c in Counter(texts).items() if c > 1]\nif dup:\n    errors.append(f\"duplicate texts: {dup}\")\n\nif len(records) != 500:\n    errors.append(f\"count {len(records)}\")\n\nintent_counts = Counter(r[\"intent\"] for r in records)\nexpected_intents = {\n    \"request_flow\": 140,\n    \"inform\": 140,\n    \"greet\": 40,\n    \"affirm\": 30,\n    \"deny\": 30,\n    \"request_stop\": 30,\n    \"request_resume\": 30,\n    \"request_quit\": 30,\n    \"UNK\": 30,\n}\nif dict(intent_counts) != expected_intents:\n    errors.append(f\"intent counts {dict(intent_counts)}\")\n\ngreet_named = [r for r in records if r[\"intent\"] == \"greet\" and r[\"slots\"]]\ngreet_plain_r = [r for r in records if r[\"intent\"] == \"greet\" and not r[\"slots\"]]\nif len(greet_named) != 20 or len(greet_plain_r) != 20:\n    errors.append(f\"greet split named={len(greet_named)} plain={len(greet_plain_r)}\")\nfor r in greet_named:\n    if [s[\"type\"] for s in r[\"slots\"]] != [\"name\"]:\n        errors.append(f\"greet slots {r['text']}\")\n\nfor r in records:\n    if r[\"text\"] in forbidden_exact:\n        errors.append(f\"copied example: {r['text']}\")\n    for a in ambiguous:\n        if a in r[\"text\"]:\n            errors.append(f\"ambiguous phrase {a} in {r['text']}\")\n    if r[\"intent\"] not in (\"inform\", \"greet\") and r[\"slots\"]:\n        errors.append(f\"unexpected slots {r['intent']} {r['text']}\")\n    if r[\"intent\"] == \"inform\" and not r[\"slots\"]:\n        errors.append(f\"inform without slots {r['text']}\")\n    if any(s[\"type\"] not in (\"name\", \"flow_ref\", \"part\", \"theme\", \"choice\") for s in r[\"slots\"]):\n        errors.append(f\"bad slot type {r['text']}\")\n    # hints\n    hints = r.get(\"slot_hints\") or []\n    hinted_idx = set()\n    for h in hints:\n        if h[\"slot\"] in hinted_idx:\n            errors.append(f\"dup hint {r['text']}\")\n        hinted_idx.add(h[\"slot\"])\n        if h[\"value\"] not in HINT_OK:\n            errors.append(f\"bad hint value {h} {r['text']}\")\n        if not (0 <= h[\"slot\"] < len(r[\"slots\"])):\n            errors.append(f\"bad hint index {r['text']}\")\n        else:\n            st = r[\"slots\"][h[\"slot\"]][\"type\"]\n            if st not in (\"flow_ref\", \"part\", \"theme\"):\n                errors.append(f\"hint on {st} {r['text']}\")\n    for i, s in enumerate(r[\"slots\"]):\n        surface = r[\"text\"][s[\"start\"]:s[\"end\"]]\n        hint = next((h[\"value\"] for h in hints if h[\"slot\"] == i), None)\n        if s[\"type\"] == \"flow_ref\":\n            known = KNOWN_FLOW.get(surface)\n            if known and hint and hint != known:\n                errors.append(f\"flow hint mismatch {surface} {hint}\")\n            if not known and not hint:\n                errors.append(f\"flow needs hint: {surface!r} in {r['text']!r}\")\n        elif s[\"type\"] == \"part\":\n            known = KNOWN_PART.get(surface)\n            if known and hint and hint != known:\n                errors.append(f\"part hint mismatch {surface} {hint}\")\n            if not known and not hint:\n                errors.append(f\"part needs hint: {surface!r} in {r['text']!r}\")\n        elif s[\"type\"] == \"theme\":\n            known = KNOWN_THEME.get(surface)\n            if known and hint and hint != known:\n                errors.append(f\"theme hint mismatch {surface} {hint}\")\n            if not known and not hint:\n                errors.append(f\"theme needs hint: {surface!r} in {r['text']!r}\")\n        elif s[\"type\"] == \"choice\":\n            if not (set(surface) & (CN_NUM | ARB_NUM)):\n                errors.append(f\"choice without number {surface!r} {r['text']!r}\")\n            if surface[-1] in \"吧啊呢吗呀哦\":\n                errors.append(f\"choice includes particle {surface!r}\")\n        elif s[\"type\"] == \"name\":\n            if any(x in surface for x in \"的了我叫是姓你\"):\n                errors.append(f\"name looks wrong {surface!r} in {r['text']!r}\")\n\n# request_flow breakdown\nrf = [r for r in records if r[\"intent\"] == \"request_flow\"]\n\ndef has(r, t):\n    return any(s[\"type\"] == t for s in r[\"slots\"])\n\nrf_none_n = sum(1 for r in rf if not r[\"slots\"])\nrf_flow_only = sum(1 for r in rf if has(r, \"flow_ref\") and not has(r, \"part\") and not has(r, \"theme\"))\nrf_flow_extra_n = sum(1 for r in rf if has(r, \"flow_ref\") and (has(r, \"part\") or has(r, \"theme\")))\nrf_part_only = sum(1 for r in rf if has(r, \"part\") and not has(r, \"theme\") and not has(r, \"flow_ref\"))\nrf_theme_only = sum(1 for r in rf if has(r, \"theme\") and not has(r, \"part\") and not has(r, \"flow_ref\"))\nrf_pt = sum(1 for r in rf if has(r, \"part\") and has(r, \"theme\") and not has(r, \"flow_ref\"))\nrf_other = len(rf) - (rf_none_n + rf_flow_only + rf_flow_extra_n + rf_part_only + rf_theme_only + rf_pt)\nif (rf_none_n, rf_flow_only, rf_flow_extra_n, rf_part_only, rf_theme_only, rf_pt, rf_other) != (20, 30, 10, 25, 25, 30, 0):\n    errors.append(\n        f\"rf breakdown none={rf_none_n} flow={rf_flow_only} extra={rf_flow_extra_n} part={rf_part_only} theme={rf_theme_only} pt={rf_pt} other={rf_other}\"\n    )\n\n# inform slot coverage\ninf = [r for r in records if r[\"intent\"] == \"inform\"]\ninf_types = Counter()\nmulti = 0\nfor r in inf:\n    ts = [s[\"type\"] for s in r[\"slots\"]]\n    for t in ts:\n        inf_types[t] += 1\n    if len(ts) > 1:\n        multi += 1\nfor t in (\"name\", \"flow_ref\", \"part\", \"theme\", \"choice\"):\n    if inf_types[t] == 0:\n        errors.append(f\"inform missing {t}\")\nif multi < 20:\n    errors.append(f\"inform multi too few {multi}\")\n\n# canonical coverage in inform + request\ndef surfaces(intent, typ, table):\n    found = set()\n    for r in records:\n        if intent and r[\"intent\"] != intent:\n            continue\n        for s in r[\"slots\"]:\n            if s[\"type\"] == typ:\n                found.add(r[\"text\"][s[\"start\"]:s[\"end\"]])\n    return found\n\nfor label, table, typ in (\n    (\"part\", KNOWN_PART, \"part\"),\n    (\"theme\", KNOWN_THEME, \"theme\"),\n    (\"flow\", KNOWN_FLOW, \"flow_ref\"),\n):\n    found = surfaces(None, typ, table)\n    missing = [k for k in table if k not in found]\n    if missing:\n        errors.append(f\"missing {label} surfaces {missing}\")\n\n# choice number coverage\nchoice_surf = []\nfor r in records:\n    for s in r[\"slots\"]:\n        if s[\"type\"] == \"choice\":\n            choice_surf.append(r[\"text\"][s[\"start\"]:s[\"end\"]])\njoined = \" \".join(choice_surf)\nfor d in \"123456789\":\n    if d not in joined:\n        errors.append(f\"missing arabic {d}\")\nif \"10\" not in joined and \"第10\" not in joined:\n    errors.append(\"missing 10\")\nfor ch in \"一二三四五六七八九十\":\n    if ch not in joined:\n        errors.append(f\"missing cn num {ch}\")\n\n# ids unique and continuous\nids = [r[\"record_id\"] for r in records]\nif len(set(ids)) != 500:\n    errors.append(\"id dup\")\nif ids[0] != f\"{PREFIX}-000001\" or ids[-1] != f\"{PREFIX}-000500\":\n    errors.append(\"id range\")\n\n# long texts warning\nlong_ones = [r[\"text\"] for r in records if len(r[\"text\"]) > 28]\nnames = []\nfor r in records:\n    for s in r[\"slots\"]:\n        if s[\"type\"] == \"name\":\n            names.append(r[\"text\"][s[\"start\"]:s[\"end\"]])\nif len(names) != len(set(names)):\n    errors.append(f\"duplicate names {[n for n,c in Counter(names).items() if c>1]}\")\n\nif errors:\n    print(\"ERRORS\", len(errors))\n    for e in errors:\n        print(e)\n    raise SystemExit(1)\n\n# write files\nfor i in range(10):\n    chunk = records[i * 50:(i + 1) * 50]\n    path = OUT / f\"part-{i+1:02d}.jsonl\"\n    with path.open(\"w\", encoding=\"utf-8\", newline=\"\\n\") as f:\n        for r in chunk:\n            obj = {\n                \"record_id\": r[\"record_id\"],\n                \"text\": r[\"text\"],\n                \"intent\": r[\"intent\"],\n                \"slots\": r[\"slots\"],\n            }\n            if \"slot_hints\" in r:\n                obj[\"slot_hints\"] = r[\"slot_hints\"]\n            f.write(json.dumps(obj, ensure_ascii=False, separators=(\",\", \":\")) + \"\\n\")\n\nprint(\"wrote\", len(records))\nprint(\"intents\", dict(intent_counts))\nprint(\"rf\", rf_none_n, rf_flow_only, rf_flow_extra_n, rf_part_only, rf_theme_only, rf_pt)\nprint(\"inform slots\", dict(inf_types), \"multi\", multi)\nprint(\"names\", len(names), \"unique\")\nprint(\"choice\", choice_surf)\nprint(\"long\", long_ones)\nprint(\"hints\", sum(1 for r in records if \"slot_hints\" in r))\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"C:\\Users\\ghost\\AppData\\Local\\Temp\\opencode\\gen_showroom.py","exists":false,"truncated":false},"title":"..\\..\\..\\Users\\ghost\\AppData\\Local\\Temp\\opencode\\gen_showroom.py","time":{"start":1793713481409,"end":1793713481421}},"metadata":{"